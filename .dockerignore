# Keep the build context small and avoid leaking local runtime data
# (CA keys, captured proxy history) into the image.

**/.git
**/.github

backend/*.db
backend/*.db-shm
backend/*.db-wal
backend/server
**/*.pem

frontend/node_modules
frontend/dist
frontend/.oxlintrc.json.bck

.claude
.vscode
.idea
*.md
!README.md
